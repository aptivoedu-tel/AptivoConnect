# ─────────────────────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Aptivo
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/aptivo_db
# Optional local DNS override when the system resolver refuses MongoDB SRV queries.
# Leave unset when deployment DNS already works.
MONGODB_DNS_SERVERS=

# ─────────────────────────────────────────────────────────────
# Auth (NextAuth)
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret



# ─────────────────────────────────────────────────────────────
# Email (Resend — aptivo.tech domain)
# Get API key from: https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Email Fallback (Brevo SMTP via Nodemailer)
# Get SMTP credentials from: https://app.brevo.com/settings/keys/smtp
# ─────────────────────────────────────────────────────────────
BREVO_SMTP_USER=your_brevo_smtp_email
BREVO_SMTP_KEY=your_brevo_smtp_key

# ─────────────────────────────────────────────────────────────
# Native Aptivo wrapper / Expo push (server-only)
# ─────────────────────────────────────────────────────────────
# Optional: Expo access token for enhanced Expo Push Service authentication.
# Never expose this value through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
EXPO_PUSH_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# AI Assistant (GitHub Model Inference — server-only, NEVER NEXT_PUBLIC_*)
# Rotate the previously exposed token before setting this.
# ─────────────────────────────────────────────────────────────
GITHUB_AI_TOKEN=
